# Nombre mostrado en la interfaz (opcional).
VITE_APP_NAME=Perfumeria SC

# Desarrollo local: URL de la API local de Supabase.
# Para despliegues, configura estas variables en el entorno de Vercel correspondiente.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (anon) del stack local. Nunca uses service_role ni una clave secreta.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
